{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Node runs these files by stripping types, never by compiling them, so
    // type checking is all this project does. `erasableSyntaxOnly` rejects the
    // TypeScript constructs Node cannot strip (enums, namespaces, parameter
    // properties), and importing with a `.ts` extension is what Node resolves
    // at runtime.
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "app"]
}
