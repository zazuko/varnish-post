{
  "name": "varnish-test-backend",
  "version": "0.1.0",
  "description": "Application to be used as a backend for varnish tests",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && node ./dist/index.js",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "typescript",
    "starter",
    "project",
    "template"
  ],
  "author": {
    "name": "Ludovic Muller",
    "url": "https://ludovic-muller.fr/"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "fastify": "^5.12.0"
  }
}
